iped"],"mvp":null,"note":"","version":4,"how":"combat","deck":"meren-aristocrats"},{"id":"g13","played":"2026-09-21T05:00:00+00:00","result":"loss","opponents":["Atraxa, Praetors' Voice"],"opponent_ids":["o-atraxa"],"turn":9,"issues":["no_win"],"mvp":null,"note":"","version":3,"how":"combat","deck":"riders-of-rohan"}],"chats":[{"id":"d3e0c4a7f00d","title":"Wie spiele ich Meren gegen Tims Atraxa?","created":"2026-10-09T19:00:00+00:00","updated":"2026-10-09T19:00:00+00:00","messages":[{"id":"d3e0a1b2c3","asked":"2026-10-09T19:00:00+00:00","question":"Wie spiele ich Meren gegen Tims Atraxa?","answer":"**Kurz:** Gegen Atraxa gewinnst du über Zeit, nicht über einen großen Zug – halte Removal für ihre Proliferate-Engine zurück und mach sie mit {{meren-aristocrats}} Runde für Runde ärmer.\n\n#### Darauf achten\n- [[Grave Pact]] erst legen, wenn du selbst Opfer-Futter hast – Atraxa spielt wenige, aber große Kreaturen.\n- Ihr Board Wipe kommt meist in Zug 6–7: lass Meren dann lieber auf der Hand.\n- [[Gray Merchant of Asphodel]] zweimal zurückholen reicht oft, weil Atraxa wenig Leben dazubekommt.\n\n| Gegen Tim | Bilanz |\n|---|---|\n| {{meren-aristocrats}} | 1 : 1 |\n\nZwei Partien sagen noch wenig – nach ein paar mehr wird das Bild klarer.","deep":false,"source":"phone","decks":{"meren-aristocrats":"Meren Aristocrats"}}]}],"players":["Jonas","Lisa","Marvin","Tim"],"options":{"results":{"win":"Sieg","loss":"Niederlage","draw":"Unentschieden"},"issues":[["few_lands","zu wenige Länder"],["flood","zu viele Länder gezogen"],["colors","falsche Farben / Farbprobleme"],["slow","zu langsam"],["no_draw","Hand leer, zu wenig Kartenzug"],["no_removal","keine Antwort auf Bedrohungen"],["wiped","Board Wipe hat mich zurückgeworfen"],["commander_removed","Commander ständig entfernt"],["no_win","kein Weg zu gewinnen"],["combo","gegen eine Combo verloren"],["fliers","gegen Flieger / Ausweichen verloren"],["too_strong","Deck war zu stark für die Runde"]],"tags":[["combo","Combo"],["fast","sc