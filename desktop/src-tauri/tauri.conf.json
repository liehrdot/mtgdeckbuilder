{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTG Deckbuilder",
  "version": "0.1.1",
  "identifier": "app.mtgdeck.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MTG Deckbuilder",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/mtgdeck-backend/": "backend/"
    },
    "publisher": "liehrdot",
    "category": "Game",
    "shortDescription": "Commander-Decks bauen, testen, drucken – mit Claude",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/liehrdot/mtgdeckbuilder/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxODVBQjczRDU1NDIyRkYKUldUL0lsVFZjNnVGa1hCdHBnMUhvTTFEOTc4VDNNenJkVW1YMFg3aFdzclZXeWVqNEhWa3dlbWYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
